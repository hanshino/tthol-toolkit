# Runtime log (regenerated each run, never committed)
*.log

# Python-generated files
__pycache__/
*.py[oc]
build/
_build/
_build_log.txt
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Snapshot database (user data, not source code)
*.db

# Generated scan data
candidates.json
pointer_history.json
pointers.json

# Reverse-engineering / diagnostic scratch scripts (kept locally, not the app)
_bx_profile.py
probe_buff.py

# AHK/game scripts
*.Q

# Claude Code local config — but project slash commands are shared, not local.
# A triage skill that lives on one machine cannot do its job: the point is that
# a fresh clone (or a fresh agent session) can run it without being told how.
#
# Must exclude the *contents* (.claude/*), not the directory (.claude/): git
# never descends into an excluded directory, so a `!` re-include under it is
# silently inert.
.claude/*
!.claude/commands/

# Opencode local config
.opencode/
# Release toolkit (distributed in zip, not committed)
toolkit/

# Git worktrees
.worktrees/

# User preferences (generated at runtime)
config.json

# Generated CSV exports (regenerated on demand)
exports/tthol_*.csv
tthol_*.csv

# WebUI build artifacts
webui/node_modules/
webui/dist/
webui/src/**/*.js
webui/openapi.json

# OMC working state (keep shared skills under version control)
**/.omc/*
!.omc/skills/

# Diagnostics (runtime artifacts; the real ones live in %LOCALAPPDATA%)
events.jsonl
events.jsonl.*
tthol-diag-*.zip
tthol-reader.log
