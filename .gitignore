# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Snapshot database (user data, not source code)
*.db

# Generated scan data
candidates.json
pointer_history.json
pointers.json

# AHK/game scripts
*.Q

# Claude Code local config
.claude/

# Opencode local config
.opencode/
# Release toolkit (distributed in zip, not committed)
toolkit/

# Git worktrees
.worktrees/

# User preferences (generated at runtime)
config.json

# Generated CSV exports (regenerated on demand)
exports/tthol_*.csv

# WebUI build artifacts
webui/node_modules/
webui/dist/
webui/src/**/*.js
webui/openapi.json

# OMC dev server port file
.omc/.dev-port
